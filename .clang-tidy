# Clockwork's clang-tidy configuration: the checks that find the crash
# classes the engine has had (owning raw pointers, hand-managed handles,
# detached and force-killed threads, exceptions out of thread functions),
# and the modern-C++ shapes that rule them out by construction. Run on the
# native sources (src/, not src/vendor, not smoothie) with the compile
# database: cmake -DCMAKE_EXPORT_COMPILE_COMMANDS=ON, then
#   clang-tidy -p build src/native/ClockworkEngine.cpp
# CI runs it over every file a change touches.
Checks: >
  -*,
  clang-analyzer-*,
  -clang-analyzer-optin.performance.Padding,
  -clang-analyzer-security.ArrayBound,
  bugprone-*,
  -bugprone-easily-swappable-parameters,
  -bugprone-narrowing-conversions,
  cppcoreguidelines-owning-memory,
  cppcoreguidelines-no-malloc,
  cppcoreguidelines-pro-type-member-init,
  cppcoreguidelines-prefer-member-initializer,
  cppcoreguidelines-special-member-functions,
  cppcoreguidelines-virtual-class-destructor,
  concurrency-*,
  misc-unused-using-decls,
  modernize-make-unique,
  modernize-make-shared,
  modernize-use-nullptr,
  modernize-use-override,
  modernize-use-using,
  modernize-avoid-c-arrays,
  modernize-loop-convert,
  performance-unnecessary-copy-initialization,
  performance-unnecessary-value-param,
  readability-container-size-empty
WarningsAsErrors: '*'   # at zero on Linux and macOS (CI tidy): the next finding fails the job
# Our headers, named by where they are: src/*.h, src/*.hpp and our subdirectories. A positive list, since the
# regex engine here (llvm::Regex, POSIX ERE) has no lookahead: a "not vendor" written as one let the vendored
# dr_flac.h through to the analyzer.
HeaderFilterRegex: '/src/([^/]+\.(h|hpp)|(clock|comms|embed|host|lanes|native|nif|ring|scheduler|workers)/)'
# The analyzer reports a path's finding wherever it lands — this exclusion, the header filter and a system
# include all leave it be — and its one finding is inside the vendored FLAC decoder (dr_flac.h, not ours to fix),
# from security.ArrayBound; that check is off above until a toolchain can keep vendored code out of the analyzer.
# Needs clang-tidy 19 or later, which CI installs (ci.yml tidy job).
ExcludeHeaderFilterRegex: '.*/(vendor|smoothie|_deps)/.*'
CheckOptions:
  cppcoreguidelines-special-member-functions.AllowSoleDefaultDtor: true
  cppcoreguidelines-special-member-functions.AllowMissingMoveFunctions: true
  modernize-avoid-c-arrays.AllowStringArrays: true
